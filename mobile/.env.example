# Copy to mobile/.env and fill in. Never commit .env.
#
# Must match the port the Node server actually listens on — it defaults to 8080
# (server/src/env.ts, `PORT ?? 8080`), not 3000.
#
# `localhost` works from the iOS simulator and from a physical device over
# `adb reverse`. It does NOT work from an Android emulator, which reaches the
# host machine at 10.0.2.2 instead:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#
# Anything set here is compiled into the shipped bundle and readable by anyone
# who downloads the app. Public values only — never a secret.
EXPO_PUBLIC_API_URL=http://localhost:8080

# The Web client ID (console.cloud.google.com → APIs & Services →
# Credentials). It is the `audience` server/.env's GOOGLE_CLIENT_ID verifies
# against, and the `webClientId` @react-native-google-signin/google-signin
# needs even on Android. Public, same as the URL above — never a secret. The
# separate Android OAuth client bound to uz.mizanapp.app's package and
# signing certificate is matched by Google automatically; this app never
# references it by ID.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
