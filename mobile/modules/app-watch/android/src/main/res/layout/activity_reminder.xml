<?xml version="1.0" encoding="utf-8"?>
<!--
  task 20 fix round 1: a translucent Activity, not a WindowManager overlay
  view (see ReminderActivity). The scrim dims whatever the blocked app had
  drawn before this launched on top of it; the card is the whole reminder.
  "bu qulf emas, eslatma": in remind mode, both buttons just finish the
  Activity, there is no path through this screen that closes or blocks the
  app underneath.

  Task 23 added lock mode's own pair of buttons (lock_home, lock_stop),
  hidden by default and shown by ReminderActivity in place of the remind
  buttons above: one layout, two button sets, switched in code rather than
  two separate layout files, since the card itself (title, body, scrim) is
  identical either way.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#F8F2EA"
        android:padding="24dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fokus rejimi"
            android:textColor="#0F0E0C"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminder_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#50320F"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/reminder_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#50320F"
            android:text="Davom etish"
            android:textColor="#FFFCF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/reminder_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Yopish"
            android:textColor="#50320F"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/lock_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#50320F"
            android:text="Bosh ekran"
            android:textColor="#FFFCF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lock_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Fokusni to'xtatish"
            android:textColor="#50320F"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
