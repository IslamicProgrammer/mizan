{
  "expo": {
    "name": "Mizan",
    "slug": "mizan",
    "scheme": "mizan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.mizanapp.app"
    },
    "android": {
      "package": "uz.mizanapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#50320F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#50320F"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#50320F",
          "defaultChannel": "prayers"
        }
      ],
      "./modules/app-watch/plugin/withAppWatch",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qibla yo'nalishini to'g'ri hisoblash uchun joylashuvingiz kerak."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# play-services-auth already ships its own consumer rules, but GoogleSignInAccount's public getters (displayName, photoUrl, idToken) are exactly the kind of accessor R8 has been reported to strip in field tests across other RN apps using this library -- keep them, since a stripped getter here would silently return null for the name and photo Task 28 depends on.\n-keep class com.google.android.gms.auth.api.signin.** { *; }",
            "packagingOptions": {
              "exclude": [
                "**/libbarhopper_v3.so"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
