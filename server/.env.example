DATABASE_URL=
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
GOOGLE_CLIENT_ID=
PORT=
# From .secrets/gemini.key locally. Sent only in the x-goog-api-key header on
# the call to Gemini, never in a URL or a log line.
GEMINI_API_KEY=

# Set to true ONLY when /scan should be reachable. It has no authentication
# until login ships, and every call spends a Gemini request.
SCAN_PUBLIC=
# Ceiling on scans per 24h, whoever is calling. Defaults to 500.
SCAN_DAILY_MAX=
